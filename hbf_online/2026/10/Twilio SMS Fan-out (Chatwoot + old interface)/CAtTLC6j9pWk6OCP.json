{"id":"CAtTLC6j9pWk6OCP","name":"Twilio SMS Fan-out (Chatwoot + old interface)","description":"Receives Twilio inbound SMS, verifies the signature, and forwards each message to Chatwoot and the previous Twilio interface during the changeover.","active":false,"activeVersionId":null,"createdAt":"2026-10-03T18:42:41.360Z","updatedAt":"2026-10-03T18:44:37.633Z","isArchived":false,"versionId":"122e35ea-b6c6-49c1-9ab1-760b98ca42d4","versionCounter":4,"sourceWorkflowId":null,"triggerCount":0,"nodes":[{"parameters":{"content":"## Twilio SMS fan-out\nTwilio -> this webhook -> Chatwoot AND your old interface.\n\n**Setup**\n1. Edit the CONFIG block in **Prepare**.\n2. Paste your Twilio Auth Token into BOTH Sign nodes (Secret).\n3. Publish the workflow and copy the Production URL of **Twilio Incoming SMS**.\n4. In Twilio, set the number (or Messaging Service) \"A message comes in\" webhook to that URL, HTTP POST.\n\nFirst test: set checkIncomingSignature to false. Once texts arrive in both places, set it back to true.","height":340,"width":440},"id":"1655624d-8b82-4127-9e11-1fdbff7c103e","name":"Sticky Note 787e6dd9","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[-144,-544]},{"parameters":{"httpMethod":"POST","path":"twilio-sms-fanout","responseMode":"responseNode","options":{}},"id":"d14c40f5-bbbb-4e9b-8573-9f61d9669545","name":"Twilio Incoming SMS","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"webhookId":"8784d236-1787-4ea3-8ead-0e17cf1f378b"},{"parameters":{"jsCode":"// ===== CONFIG: edit these =====\nconst CONFIG = {\n  // Production URL of the 'Twilio Incoming SMS' node (must match what Twilio calls, character for character)\n  n8nWebhookUrl: 'https://hbf.app.n8n.cloud/webhook/twilio-sms-fanout',\n  // Your Chatwoot Twilio callback\n  chatwootUrl: 'https://YOUR-CHATWOOT-DOMAIN/twilio/callback',\n  // The webhook URL Twilio used BEFORE this change (copy it from the Twilio number settings first)\n  oldAppUrl: 'PASTE_OLD_WEBHOOK_URL_HERE',\n  // Reject requests not genuinely from Twilio. Set false only for the first test.\n  checkIncomingSignature: true,\n};\n// ==============================\n\nconst item = $input.first().json;\nconst params = item.body || {};\nconst headers = item.headers || {};\n\n// Twilio signature base: full URL + each POST param name+value, sorted by name\nconst joined = Object.keys(params).sort().map((k) => k + (params[k] ?? '')).join('');\n\nreturn [{\n  json: {\n    ...CONFIG,\n    from: params.From || '',\n    body: params.Body || '',\n    formBody: new URLSearchParams(params).toString(),\n    incomingSignature: headers['x-twilio-signature'] || '',\n    signStringIncoming: CONFIG.n8nWebhookUrl + joined,\n    signStringOldApp: CONFIG.oldAppUrl + joined,\n  },\n}];"},"id":"16fcd975-90de-4eb5-a077-f4c6a846ea6f","name":"Prepare","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,0]},{"parameters":{"action":"hmac","type":"SHA1","value":"={{ $json.signStringIncoming }}","dataPropertyName":"expectedSignature","secret":"PASTE_TWILIO_AUTH_TOKEN","encoding":"base64"},"id":"1c19e5c9-3045-4515-944d-2029ba03812d","name":"Sign: verify Twilio","type":"n8n-nodes-base.crypto","typeVersion":1,"position":[448,0]},{"parameters":{"action":"hmac","type":"SHA1","value":"={{ $json.signStringOldApp }}","dataPropertyName":"oldAppSignature","secret":"PASTE_TWILIO_AUTH_TOKEN","encoding":"base64"},"id":"e90906e1-f678-4ee3-89cd-3a59fd5e57f4","name":"Sign: old interface","type":"n8n-nodes-base.crypto","typeVersion":1,"position":[672,0]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"leftValue":"={{ !$json.checkIncomingSignature || $json.expectedSignature === $json.incomingSignature }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true},"id":"c9e125f8-c87a-4556-a4da-ee725c214663"}],"combinator":"and"},"options":{}},"id":"f81af15a-9f64-48ff-892c-e02806a860b7","name":"Is from Twilio?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[880,0]},{"parameters":{"respondWith":"text","responseBody":"<Response></Response>","options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/xml"}]}}},"id":"f770ed0b-45aa-4baa-aa7b-3a5dc247c839","name":"Reply OK to Twilio","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1104,-96]},{"parameters":{"respondWith":"noData","options":{"responseCode":403}},"id":"886d7a94-ff28-4f87-b803-c1f5f9fcadae","name":"Reject (bad signature)","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1104,128]},{"parameters":{"method":"POST","url":"={{ $json.chatwootUrl }}","sendBody":true,"contentType":"raw","rawContentType":"application/x-www-form-urlencoded","body":"={{ $json.formBody }}","options":{"timeout":15000}},"id":"79c648fb-7033-48a6-8978-8adb902edcfb","name":"Forward to Chatwoot","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[1344,-208],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000,"onError":"continueRegularOutput"},{"parameters":{"method":"POST","url":"={{ $json.oldAppUrl }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-Twilio-Signature","value":"={{ $json.oldAppSignature }}"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/x-www-form-urlencoded","body":"={{ $json.formBody }}","options":{"timeout":15000}},"id":"439d16cf-4ac4-40b7-ad60-28fc58f962cb","name":"Forward to old interface","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[1344,0],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000,"onError":"continueRegularOutput"}],"connections":{"Twilio Incoming SMS":{"main":[[{"node":"Prepare","type":"main","index":0}]]},"Prepare":{"main":[[{"node":"Sign: verify Twilio","type":"main","index":0}]]},"Sign: verify Twilio":{"main":[[{"node":"Sign: old interface","type":"main","index":0}]]},"Sign: old interface":{"main":[[{"node":"Is from Twilio?","type":"main","index":0}]]},"Is from Twilio?":{"main":[[{"node":"Reply OK to Twilio","type":"main","index":0}],[{"node":"Reject (bad signature)","type":"main","index":0}]]},"Reply OK to Twilio":{"main":[[{"node":"Forward to Chatwoot","type":"main","index":0},{"node":"Forward to old interface","type":"main","index":0}]]}},"nodeGroups":[{"id":"3cafd06c-ee69-48e3-a544-b7b3afaa5917","name":"Verify request","nodeIds":["16fcd975-90de-4eb5-a077-f4c6a846ea6f","1c19e5c9-3045-4515-944d-2029ba03812d","e90906e1-f678-4ee3-89cd-3a59fd5e57f4"],"description":"Builds the form body and checks the X-Twilio-Signature so only genuine Twilio texts are forwarded"}],"settings":{"executionOrder":"v1","availableInMCP":true,"binaryMode":"separate"},"staticData":null,"pinData":{},"meta":{"aiBuilderAssisted":true,"builderVariant":"mcp"},"tags":[],"shared":[{"role":"workflow:owner","workflowId":"CAtTLC6j9pWk6OCP","projectId":"pPfvO125ydUVIXPh","project":{"id":"pPfvO125ydUVIXPh","name":"Alex  Clifton <alex@honeybearfinancials.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"b5c2bbf4-eb13-4025-80fb-2acb074cc668","createdAt":"2025-12-08T14:51:42.916Z","updatedAt":"2026-02-19T12:35:36.791Z"},"createdAt":"2026-10-03T18:42:41.383Z","updatedAt":"2026-10-03T18:42:41.383Z"}],"activeVersion":null,"parentFolder":null}